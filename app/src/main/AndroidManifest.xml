<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos necesarios para Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LosZETAS"
        tools:targetApi="31">

        <!-- ========================================= -->
        <!-- ACTIVIDADES EXISTENTES                    -->
        <!-- ========================================= -->
        <activity
            android:name=".PantallaPrincipalActivity"
            android:exported="false" />

        <!-- Pantalla de Bienvenida (MainActivity) - PANTALLA INICIAL -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Registro -->
        <activity
            android:name=".RegistrarseActivity"
            android:exported="false" />

        <!-- Pantalla de Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- ========================================= -->
        <!-- 🆕 PANTALLAS DE DANIEL (7 nuevas)        -->
        <!-- ========================================= -->

        <!-- 3. Agregar Transacción -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false" />

        <!-- 4. Selector de Categoría -->
        <activity
            android:name=".CategorySelectorActivity"
            android:exported="false" />

        <!-- 5. Historial -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- 6. Estadísticas -->
        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <!-- 7. Presupuestos y Metas -->
        <activity
            android:name=".GoalsActivity"
            android:exported="false" />

        <!-- 8. Crear Presupuesto -->
        <activity
            android:name=".NewBudget"
            android:exported="false" />

        <!-- 9. Crear Meta -->
        <activity
            android:name=".NewGoal"
            android:exported="false" />

    </application>

</manifest>