<?xml version="1.0" encoding="utf-8"?>
<!--
    ITEM: Top categoría con progreso
    Muestra categoría con monto y barra de progreso
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: ícono + nombre + monto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Ícono de categoría -->
            <ImageView
                android:id="@+id/ivCategoriaIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_categoria_default"
                android:tint="@color/primary_dark"
                android:padding="8dp"
                android:background="@drawable/circle_background" />

            <!-- Nombre de categoría -->
            <TextView
                android:id="@+id/tvCategoriaNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Categoría"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

            <!-- Monto gastado -->
            <TextView
                android:id="@+id/tvCategoriaMontoTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bs. 0.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

        </LinearLayout>

        <!-- Barra de progreso + porcentaje -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/progressCategoria"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/primary_dark"
                android:progressBackgroundTint="@color/accent_beige" />

            <!-- Porcentaje -->
            <TextView
                android:id="@+id/tvPorcentaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="12sp"
                android:textColor="@color/primary_medium"
                android:layout_marginStart="8dp"
                android:minWidth="35dp"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>