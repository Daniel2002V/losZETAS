<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- Contenedor superior centrado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- Icono de billetera -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_wallet"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/wallet_icon" />

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu Finanzas, Claro y Simple"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1a1a1a"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registra ingresos y gastos, define presupuestos y alcanza tus metas de ahorro."
            android:textSize="13sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="2dp" />

        <!-- Contenedor de botones -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Botón Registrarse (outline) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_registrarse"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Registrarse"
                android:textColor="#7C3AED"
                android:background="@drawable/bg_button_outline"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:layout_marginEnd="12dp"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Botón Iniciar Sesión (filled) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_iniciar_sesion"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Iniciar Sesión"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

    <!-- Línea punteada en la parte inferior (opcional, como en el mockup) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:background="@drawable/dotted_line" />

</RelativeLayout>