<?xml version="1.0" encoding="utf-8"?>
<!--
    PANTALLA: Historial de Transacciones
    Muestra todas las transacciones con filtros, búsqueda y swipe to delete
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- TOOLBAR SUPERIOR -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary_dark"
            app:title="Historial"
            app:titleTextColor="@color/white"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- CONTENIDO PRINCIPAL CON SCROLL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- ============================================ -->
            <!-- BUSCADOR                                     -->
            <!-- ============================================ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/white">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar transacción..."
                    app:startIconDrawable="@android:drawable/ic_menu_search"
                    app:startIconTint="@color/primary_medium"
                    app:boxBackgroundMode="none"
                    app:hintTextColor="@color/primary_medium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBuscar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:textColor="@color/primary_dark"
                        android:padding="16dp" />

                </com.google.android.material.textfield.TextInputLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================ -->
            <!-- FILTROS RÁPIDOS DE FECHA                     -->
            <!-- ============================================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Período"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFechas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:checkedChip="@id/chipHoy">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHoy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hoy"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSemana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Esta semana"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Este mes"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPersonalizado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Personalizado"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- ============================================ -->
            <!-- FILTROS: TIPO (Todos/Ingresos/Gastos)       -->
            <!-- ============================================ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupTipo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:checkedChip="@id/chipTodos">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Todos"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipIngresos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingresos"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipGastos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gastos"
                        android:checkable="true"
                        app:chipBackgroundColor="@color/chip_background_selector"
                        app:chipStrokeWidth="1dp"
                        app:chipStrokeColor="@color/primary_dark"
                        style="@style/Widget.Material3.Chip.Filter" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- ============================================ -->
            <!-- FILTRO POR CATEGORÍA + ORDENAMIENTO         -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:weightSum="2">

                <!-- Selector de categoría -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCategoria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:tint="@color/primary_dark" />

                        <TextView
                            android:id="@+id/tvCategoriaFiltro"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Categoría"
                            android:textSize="13sp"
                            android:textColor="@color/primary_dark" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="@color/primary_medium" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Ordenamiento -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOrdenar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_sort_alphabetically"
                            android:tint="@color/primary_dark" />

                        <TextView
                            android:id="@+id/tvOrdenamiento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Ordenar"
                            android:textSize="13sp"
                            android:textColor="@color/primary_dark" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/arrow_down_float"
                            android:tint="@color/primary_medium" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ============================================ -->
            <!-- CARD DE RESUMEN DEL PERÍODO                 -->
            <!-- ============================================ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardElevation="3dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen del período"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        android:layout_marginBottom="16dp" />

                    <!-- 3 columnas: Ingresos | Gastos | Balance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <!-- Ingresos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ingresos"
                                android:textSize="11sp"
                                android:textColor="@color/primary_medium" />

                            <TextView
                                android:id="@+id/tvResumenIngresos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bs. 0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#4CAF50"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Gastos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gastos"
                                android:textSize="11sp"
                                android:textColor="@color/primary_medium" />

                            <TextView
                                android:id="@+id/tvResumenGastos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bs. 0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#F44336"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <!-- Balance -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Balance"
                                android:textSize="11sp"
                                android:textColor="@color/primary_medium" />

                            <TextView
                                android:id="@+id/tvResumenBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bs. 0"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_dark"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================ -->
            <!-- HINT DE SWIPE (primera vez)                 -->
            <!-- ============================================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHintSwipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/accent_yellow"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="💡"
                        android:textSize="18sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Desliza una transacción hacia la izquierda para eliminarla"
                        android:textSize="12sp"
                        android:textColor="@color/primary_dark" />

                    <ImageView
                        android:id="@+id/btnCerrarHint"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="@color/primary_medium"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================ -->
            <!-- LISTA DE TRANSACCIONES                      -->
            <!-- ============================================ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransacciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clipToPadding="false"
                tools:listitem="@layout/item_transaction_history"
                tools:itemCount="5" />

            <!-- ============================================ -->
            <!-- ESTADO VACÍO (cuando no hay transacciones)  -->
            <!-- ============================================ -->
            <LinearLayout
                android:id="@+id/layoutEstadoVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="64sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No hay transacciones"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Comienza agregando tu primera transacción"
                    android:textSize="14sp"
                    android:textColor="@color/primary_medium"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarTransaccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Agregar transacción"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary_dark"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ============================================ -->
    <!-- BOTTOM NAVIGATION                            -->
    <!-- ============================================ -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/primary_dark"
        app:itemTextColor="@color/primary_dark"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>