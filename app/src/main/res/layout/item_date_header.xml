<?xml version="1.0" encoding="utf-8"?>
<!--
    ITEM: Header de fecha para agrupar transacciones
    Ejemplo: "Hoy, 31 Oct" o "Ayer, 30 Oct"
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- Línea izquierda -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="@color/accent_beige" />

    <!-- Texto de la fecha -->
    <TextView
        android:id="@+id/tvFechaHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hoy, 31 Oct"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/primary_medium"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- Línea derecha -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="@color/accent_beige" />

</LinearLayout>