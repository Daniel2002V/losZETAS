<?xml version="1.0" encoding="utf-8"?>
<!--
    ITEM: Transacción individual en el historial
    Soporta swipe to delete
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Ícono de categoría -->
        <ImageView
            android:id="@+id/ivCategoriaIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_categoria_default"
            android:tint="@color/primary_dark"
            android:padding="10dp"
            android:background="@drawable/circle_background" />

        <!-- Información de la transacción -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoría"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="12sp"
                android:textColor="@color/primary_medium"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="31/10/2025 14:30"
                android:textSize="11sp"
                android:textColor="@color/primary_medium"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Monto -->
        <TextView
            android:id="@+id/tvMonto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bs. 0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_dark"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>