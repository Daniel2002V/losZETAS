<?xml version="1.0" encoding="utf-8"?>
<!--
    SELECTOR: Colores para chips según estado (seleccionado/no seleccionado)
    Ubicación: res/color/chip_background_selector.xml
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado: Chip seleccionado -->
    <item android:state_checked="true" android:color="@color/primary_dark" />

    <!-- Estado: Chip no seleccionado -->
    <item android:color="@color/white" />

</selector>